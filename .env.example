# Copy to .env and fill in real values. Never commit .env.
#
# The Python suite reads python/.env first and falls back to the repository
# root .env, so if the JavaScript suite is already configured there is nothing
# to copy here - config/auth_config.py will find those values.

# --- Domain A ---
DOMAIN_A=
KEYCLOAK_URL=
CLIENT_ID=
CLIENT_SECRET=
API_USERNAME=
API_PASSWORD=

# --- Domain B ---
DOMAIN_B=
KEYCLOAK_URL_B=
CLIENT_ID_B=
CLIENT_SECRET_B=
API_USERNAME_B=
API_PASSWORD_B=

# --- Global Operator ---
DOMAIN_GLOBAL=
KEYCLOAK_URL_GLOBAL=
CLIENT_ID_GLOBAL=
CLIENT_SECRET_GLOBAL=
API_USERNAME_GLOBAL=
API_PASSWORD_GLOBAL=

# --- Simulator ---
SIMULATOR_TASKS_URL=
SIMULATOR_API_KEY=
